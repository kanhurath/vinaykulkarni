# ── Database ───────────────────────────────────────────────────────────────────
# Use plain IP/hostname, no protocol prefix
DB_HOST=your-db-host-or-ip
DB_USER=your-db-user
DB_PASS=your-db-password
DB_NAME=your-db-name

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=3001
# Must match the frontend domain exactly (no trailing slash)
CLIENT_URL=https://vinaykulkarni.com
# Used to convert relative og:image paths to absolute URLs for social crawlers
SITE_URL=https://vinaykulkarni.com

# ── Admin Auth ─────────────────────────────────────────────────────────────────
# Generate JWT_SECRET with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_USER=your-admin-username
ADMIN_PASS=your-strong-admin-password
JWT_SECRET=your-64-char-hex-secret
