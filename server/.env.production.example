# ── PRODUCTION ENVIRONMENT TEMPLATE ──────────────────────────────────────────
# Copy this file to .env on the production server and fill in real values.
# NEVER commit .env (with real secrets) to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_USER=your_db_user
DB_PASS=your_db_password
DB_NAME=vk_portal_db

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001

# SITE_URL: MUST be the public-facing domain — used for canonical URLs and
# OG image paths in server-side SEO HTML. Never use localhost here.
SITE_URL=https://vinaykulkarni.com

# ── CORS ──────────────────────────────────────────────────────────────────────
# CLIENT_URL and ALLOWED_ORIGINS are ADDITIVE to the hardcoded production
# origins in server/index.js (vinaykulkarni.com + www.vinaykulkarni.com).
# On production, leave these blank unless you have a staging subdomain.
CLIENT_URL=
ALLOWED_ORIGINS=

# ── Admin & Auth ──────────────────────────────────────────────────────────────
# ADMIN_USER / ADMIN_PASS: credentials for the CMS admin login.
# Use a strong password. Rotate these after every deployment.
ADMIN_USER=admin
ADMIN_PASS=your_strong_password_here

# JWT_SECRET: random 256-bit hex string. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotate this if it is ever exposed.
JWT_SECRET=generate_a_new_secret_here
